# Django: set a generated secret before production deployment.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set USE_MYSQL=1 and provide a least-privilege MySQL account for the demo.
# Without USE_MYSQL, local development uses backend/db.sqlite3.
USE_MYSQL=1
MYSQL_DATABASE=legal_rag
MYSQL_USER=legal_app
MYSQL_PASSWORD=replace-with-a-local-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
